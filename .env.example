# LoFi Track Manager - Environment Variables

# Notion API Token
# Get yours from: https://www.notion.so/my-integrations
NOTION_API_TOKEN=secret_your_token_here
NOTION_PARENT_FOLDER_URL=https://www.notion.so/<PATH>

# YouTube Configuration
# Get your channel ID from: YouTube Studio > Settings > Channel > Advanced settings
YOUTUBE_CHANNEL_ID=UC_your_channel_id_here